{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": { "buildType": "apk", "image": "latest" },
      "ios": { "image": "latest" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk", "image": "latest" },
      "ios": { "image": "latest" }
    },
    "production": {
      "environment": "production",
      "android": { "image": "latest" },
      "ios": { "image": "latest" }
    }
  }
}
